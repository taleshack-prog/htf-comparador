# Banco (Railway → serviço Postgres próprio do Comparador → Variables → DATABASE_URL)
DATABASE_URL=postgresql://usuario:senha@host:porta/railway
# "true" se a conexão exigir TLS (proxy público do Railway normalmente não exige)
DATABASE_SSL=false

# Painel de saúde do site HTF lê /health/summary com este token
MONITOR_TOKEN=troque-por-um-valor-longo-e-aleatorio

# Vercel Cron envia "Authorization: Bearer $CRON_SECRET" automaticamente
CRON_SECRET=troque-por-outro-valor-longo-e-aleatorio

# Sprints seguintes (ainda não usados no Sprint 0)
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BREVO_API_KEY=
# AUTH_SECRET=
